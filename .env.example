# Copy this file to .env and fill in real values for your environment.
# .env is gitignored — never commit actual secrets or deployment URLs here.
#
# This project has no secrets today (no API keys, no database), but keeps
# this file so frontend/backend URLs are configured the same documented
# way in every environment instead of being hardcoded in source.
#
# ── Production requires (the server refuses to start without these) ──────
#   NODE_ENV=production
#   CLIENT_URL=https://your-frontend-domain
# ── And the frontend build needs ──────────────────────────────────────────
#   VITE_SOCKET_SERVER_URL=https://your-backend-domain
#
# The values below are safe *local development* defaults only — do not
# copy them into a production deployment.

# ─────────────────────────────────────────────────────────────────────────
# Backend (server/server.js) — Node.js + Socket.IO
# ─────────────────────────────────────────────────────────────────────────

# Port the multiplayer server listens on.
PORT=4000

# "development" or "production". Controls log verbosity (see server/logger.js).
NODE_ENV=development

# Comma-separated list of origins allowed to connect via Socket.IO/CORS.
# Development: your local Vite dev server — safe to leave unset, in which
#   case the server allows all origins so a fresh checkout runs immediately.
# Production:  REQUIRED. Your deployed frontend's real HTTPS domain(s), e.g.
#   CLIENT_URL=https://tank-arena.example.com
#   CLIENT_URL=https://tank-arena.example.com,https://staging.tank-arena.example.com
# If NODE_ENV=production and CLIENT_URL is missing/empty, the server FAILS
# CLOSED — it refuses to start rather than silently allowing all origins.
CLIENT_URL=http://localhost:5173

# Optional — adds artificial latency (ms) to outgoing game-state/event
# broadcasts, useful for testing prediction/reconciliation locally. Leave
# unset/0 in production.
# DEV_LATENCY_MS=150

# ─────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the client
# ─────────────────────────────────────────────────────────────────────────

# URL of the multiplayer backend the client connects to.
# Development: the local server above.
# Production:  your deployed backend's real domain, e.g.
#   VITE_SOCKET_SERVER_URL=https://tank-arena-server.example.com
VITE_SOCKET_SERVER_URL=http://localhost:4000

# Optional — adds artificial latency (ms) to incoming game-state/event
# handling on the client, for local testing only.
# VITE_DEV_LATENCY_MS=150
